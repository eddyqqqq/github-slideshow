# Toate textele din joc ale mod-ului: nume de iteme, descrieri, buff-uri, setari.
# Terraria nu are limba romana, asa ca textele romanesti stau in fisierul de engleza (en-US).
# Fara diacritice (a, i, s, t simple): fontul din Terraria s-ar putea sa nu aiba literele ă, ș, ț.
# {0}, {1}, {2} sunt inlocuite automat cu numerele din cod (ca sa nu le scrii de doua ori).

Items: {
	ToiagulLicuricilor: {
		DisplayName: Toiagul Licuricilor
		Tooltip:
			'''
			Cheama un licurici care lupta pentru tine
			Lumina lui ii poate zapaci pe inamici
			'''
	}

	BiciulDeSpini: {
		DisplayName: Biciul de Spini
		Tooltip:
			'''
			{0} damage de marcare pentru minioni
			Otraveste inamicii loviti
			Minionii tai vor ataca inamicii loviti
			'''
	}

	GlugaUrsitoarei: {
		DisplayName: Gluga Ursitoarei
		Tooltip:
			'''
			+{0} slot de minion
			+{1}% damage de summon
			'''
		SetBonus:
			'''
			Stai nemiscat 2 secunde ca ursitoarele sa-ti binecuvanteze minionii:
			+{0}% damage de summon cat timp nu te misti
			'''
	}

	MantiaUrsitoarei: {
		DisplayName: Mantia Ursitoarei
		Tooltip:
			'''
			+{0} slot de minion
			+{1}% damage de summon
			'''
	}

	PantaloniiUrsitoarei: {
		DisplayName: Pantalonii Ursitoarei
		Tooltip:
			'''
			+{0} slot de minion
			+{1}% viteza de miscare
			'''
	}

	Martisor: {
		DisplayName: Martisor
		Tooltip:
			'''
			Loviturile minionilor au {0}% sansa sa-ti aduca Primavara:
			regenerezi {1} viata pe secunda timp de {2} secunde
			'''
	}

	TalismanulDeUsturoi: {
		DisplayName: Talismanul de Usturoi
		Tooltip:
			'''
			Cand esti lovit, minionii intra in Furie: +{0}% damage de summon timp de {1} secunde
			Primesti putina invulnerabilitate in plus dupa ce esti lovit
			+{2} aparare
			'''
	}

	ToiagulStrigoiului: {
		DisplayName: Toiagul Strigoiului
		Tooltip:
			'''
			Cheama un strigoi care lupta pentru tine
			Muscaturile lui iti dau uneori viata si blesteama inamicii cu flacari de umbra
			'''
	}

	ToiagulIelelor: {
		DisplayName: Toiagul Ielelor
		Tooltip:
			'''
			Cheama o iele, o zana foarte rapida care loveste des
			Vraja ei scade apararea inamicilor (Ichor)
			'''
	}

	BiciulZmeului: {
		DisplayName: Biciul Zmeului
		Tooltip:
			'''
			{0} damage de marcare pentru minioni
			Inamicii loviti iau foc
			Uneori zmeul sufla foc: o explozie care loveste inamicii din jur
			Minionii tai vor ataca inamicii loviti
			'''
	}

	CununaDeClorofita: {
		DisplayName: Cununa de Clorofita
		Tooltip:
			'''
			+{0} sloturi de minion
			+{1}% damage de summon
			Se poarta cu Chlorophyte Plate Mail si Chlorophyte Greaves
			'''
		SetBonus:
			'''
			Un cristal de frunze trage in inamicii din apropiere
			+{0} slot de minion
			'''
	}

	ToiagulSolomonarului: {
		DisplayName: Toiagul Solomonarului
		Tooltip:
			'''
			Cheama un norisor de furtuna care sta deasupra inamicilor
			si trage fulgere care trec prin ei si explodeaza
			'''
	}

	BiciulSolomonarului: {
		DisplayName: Biciul Solomonarului
		Tooltip:
			'''
			{0} damage de marcare pentru minioni
			{1}% sansa de lovitura critica pentru minioni pe inamicii marcati
			Cand lovesti, minionii tai primesc +{2}% damage cateva secunde
			Fiecare lovitura cheama un trasnet care loveste toti inamicii din jur
			'''
	}

	InimaUrsitoarelor: {
		DisplayName: Inima Ursitoarelor
		Tooltip:
			'''
			Are efectele Martisorului si ale Talismanului de Usturoi
			Loviturile minionilor incarca un scut de pana la {0} viata
			Cand esti lovit, scutul iti da inapoi viata pierduta
			+{1}% damage de summon, +{2} slot de minion
			'''
	}
}

