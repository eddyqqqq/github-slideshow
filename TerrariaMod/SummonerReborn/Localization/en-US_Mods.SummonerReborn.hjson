Configs: {
	ConfigTestare: {
		DisplayName: Setari Renasterea Invocatorului

		ModTestare: {
			Label: Mod de testare
			Tooltip:
				'''
				Cand e pornit, fiecare personaj primeste kit-ul de testare la prima intrare pe o lume.
				Opreste-l cand vrei sa joci normal, de la zero.
				Kit-ul il poti primi oricand si cu comanda /kittest.
				'''
		}

		TintireAutomataBoss: {
			Label: Minionii ataca automat boss-ul
			Tooltip: Cand e un boss in viata si n-ai ales tu o tinta, minionii ataca boss-ul.
		}

		ModOP: {
			Label: Mod OP (Binecuvantarea Ursitoarelor)
			Tooltip:
				'''
				Face Master Mode mai usor pentru summoner, dar progresia ramane normala.
				+15% damage summon, +1 minion, +6 aparare, -10% damage primit, +40 viata, +1 HP/s, biciuri cu 10% mai rapide.
				Minionii fura putina viata pentru tine, iar ursitoarele te salveaza de la moarte o data la 5 minute.
				Se aplica imediat, fara reload.
				'''
		}
	}
}
